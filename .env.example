# ==============================================================================
# CarbonTwin OS + FixTrace — Root Environment Configuration Template
# ==============================================================================
# Copy this template to .env or configure in respective backend subdirectories.
# NEVER commit real credentials to version control.

# --- Hindsight Vectorize Experiential Memory ---
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=YOUR_HINDSIGHT_API_KEY
HINDSIGHT_BANK_ID=fixtrace-final-demo-01

# --- FixTrace Operational Database ---
DATABASE_URL=sqlite:///./fixtrace.db

# --- CarbonTwin OS AI & Copilot Services ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# --- Network Ports ---
CARBONTWIN_BACKEND_PORT=8000
FIXTRACE_BACKEND_PORT=8001
FRONTEND_PORT=5173
