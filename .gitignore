# Environment & Credentials (NEVER COMMIT SECRETS)
.env
.env.*
*.env
*.env.local
*.env.production
**/.env
**/.env.*
**/*.env
**/*.env.local
**/*.env.production
!.env.example
!**/.env.example

# Dependencies & Environments
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
*.whl

# Build & Bundler outputs
dist/
**/dist/
build/
**/build/
.next/
out/
*.egg-info/
**/*.egg-info/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Local Databases
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
fixtrace.db
**/fixtrace.db

# Logs & Diagnostics
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configs
.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace

# Antigravity / Gemini IDE & Agent scratch/artifacts
.gemini/
**/.gemini/
brain/
**/brain/
scratch/
**/scratch/
.system_generated/
**/.system_generated/

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini
