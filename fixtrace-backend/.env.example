# FixTrace Experiential Maintenance Backend Environment Configuration
# Copy this file to .env and configure your credentials

# Hindsight Vectorize Cloud Memory API Endpoint
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Hindsight API Key (Vectorize platform)
HINDSIGHT_API_KEY=YOUR_HINDSIGHT_API_KEY

# Hindsight Bank Identifier (e.g., fixtrace-final-demo-01 or fixtrace-demo-01)
HINDSIGHT_BANK_ID=fixtrace-final-demo-01

# Local Operational SQLite Database URL
DATABASE_URL=sqlite:///./fixtrace.db

# Optional: Groq LLM API Key (for secondary synthesis)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# FixTrace Backend Port
PORT=8001
